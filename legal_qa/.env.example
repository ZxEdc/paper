# ============ legal_qa 配置模板 ============
# 复制为 legal_qa/.env 并按部署环境修改

# ============ 基线实验（纯 LLM，无需 GPU） ============
# DeepSeek 示例：取消注释并填入你的 key 即可用本地机器跑基线
# LLM_API_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxxxxxx

# ---- 主 LLM：vLLM OpenAI 兼容服务（AutoDL 上启动） ----
LLM_API_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen2.5-7B-Instruct
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ---- Embedding：vLLM/TEI 服务（BGE-M3, 1024 维） ----
EMBED_API_BASE_URL=http://127.0.0.1:8001/v1
EMBED_MODEL=BGE-M3
EMBED_API_KEY=EMPTY
EMBED_DIM=1024

# ---- 法条检索 ----
LAW_INDEX_DIR=data/law_index
RETRIEVAL_TOP_K=10

# ---- Skill 调度（消融实验：dynamic 为本文方法，fixed 为对照组） ----
DISPATCH_POLICY=dynamic
FACT_COMPLETENESS_THRESHOLD=0.6
MEMORY_RECALL_TOP_K=5
MAX_DIALOGUE_TURNS=30

# ---- 数据与输出 ----
DATA_DIR=data
OUTPUT_DIR=outputs
SEED=42
